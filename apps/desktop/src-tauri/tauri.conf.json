{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pix",
  "version": "../package.json",
  "identifier": "dev.pix.app",
  "build": {
    "beforeDevCommand": "pnpm run dev:frontend",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist/renderer"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Pix",
        "width": 1440,
        "height": 900,
        "minWidth": 760,
        "minHeight": 560,
        "decorations": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob: https:; font-src 'self' data:; connect-src data: ipc: http://ipc.localhost 'self'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Desktop shell for the pi coding agent",
    "icon": ["../build/icon.png", "../build/icon.icns", "../build/icon.ico"],
    "externalBin": ["binaries/node"],
    "resources": {
      "resources/sidecar/": "sidecar/",
      "resources/runtimes/": "runtimes/"
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
